rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles.
    // A user may manage their own profile. Administrators may read all
    // profiles for the Admin Dashboard and may update only the role field.
    match /users/{userId} {
      allow read: if request.auth != null
        && (
          request.auth.uid == userId
          || get(/databases/$(database)/documents/users/$(request.auth.uid))
              .data.role == "admin"
        );

      allow create: if request.auth != null
        && request.auth.uid == userId;

      allow update: if request.auth != null
        && (
          (
            request.auth.uid == userId
            && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(["username", "usernameNormalized"])
          )
          || (
            get(/databases/$(database)/documents/users/$(request.auth.uid))
              .data.role == "admin"
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["role"])
          )
        );

      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }


    // Username mappings and temporary reservations are server-managed only.
    // Cloud Functions Admin SDK accesses these collections; browser clients cannot.
    match /usernames/{username} {
      allow read, write: if false;
    }

    match /_usernameReservations/{username} {
      allow read, write: if false;
    }

    match /_usernameLoginRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /posts/{postId} {
      allow read: if true;

      allow write: if request.auth != null;
    }

    match /admin/{docId} {
      allow read, write: if
        request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.role == "admin";
    }

    // Academic transcript / session history.
    // HearMe stores saved transcript/session records in academicSessions.
    // Regular users can access only their own records; administrators can
    // read all records for authorized dashboard/reporting purposes.
    match /academicSessions/{sessionId} {

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      allow read: if request.auth != null
        && (
          resource.data.userId == request.auth.uid
          || get(/databases/$(database)/documents/users/$(request.auth.uid))
              .data.role == "admin"
        );

      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Live classroom response rooms
    match /classroomRooms/{roomId} {

      // Only the room owner may create a room they own.
      allow create: if request.auth != null
        && roomId.size() == 6
        && request.resource.data.roomCode == roomId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time;

      // An authenticated participant may join a room when they know its code.
      allow read: if request.auth != null;

      // Only the room owner may change or remove the room.
      allow update, delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;

      match /responses/{responseId} {

        // Participants in the same room can see live responses.
        allow read: if request.auth != null
          && exists(
            /databases/$(database)/documents/classroomRooms/$(roomId)
          );

        // Responses are immutable after creation and limited to the
        // authenticated user's own text.
        allow create: if request.auth != null
          && exists(
            /databases/$(database)/documents/classroomRooms/$(roomId)
          )
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 100
          && request.resource.data.createdAt == request.time;

        allow update, delete: if request.auth != null
          && resource.data.userId == request.auth.uid;
      }
    }

  }
}
